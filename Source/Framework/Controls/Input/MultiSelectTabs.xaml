<UserControl
    x:Class="LemoineTools.Framework.Controls.MultiSelectTabs"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="_outer" BorderThickness="1" CornerRadius="{DynamicResource LemoineRadius_MD}" MinHeight="150">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Search row: filter box (with placeholder overlay) + live match count + Clear -->
            <Grid Grid.Row="0" Margin="8,8,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox x:Name="_searchBox" VerticalContentAlignment="Center" />
                    <TextBlock x:Name="_searchHint"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontStyle="Italic"
                               IsHitTestVisible="False" />
                </Grid>
                <StackPanel x:Name="_searchActions"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="6,0,0,0" />
            </Grid>

            <!-- Body: group tabs | draggable divider | checkboxes for the active group.
                 The top border is the full-width rule under the search row. -->
            <Border x:Name="_body" Grid.Row="1" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" MinWidth="60" MaxWidth="220" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: group tabs -->
                    <Border x:Name="_tabColumn" Grid.Column="0" BorderThickness="0,0,1,0">
                        <ScrollViewer x:Name="_tabScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="_tabStack" />
                        </ScrollViewer>
                    </Border>

                    <!-- Draggable divider -->
                    <GridSplitter Grid.Column="1"
                                  Width="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"
                                  ResizeDirection="Columns"
                                  ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="False" />

                    <!-- Right: checkboxes for active group -->
                    <ScrollViewer x:Name="_checkScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="8,8,8,4">
                        <StackPanel x:Name="_checkStack" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
