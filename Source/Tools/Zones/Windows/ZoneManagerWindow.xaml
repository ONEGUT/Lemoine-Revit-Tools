<Window
    x:Class="LemoineTools.Tools.Zones.Windows.ZoneManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Lemoine Tools — Zone Manager"
    Width="1180" Height="700"
    MinWidth="900" MinHeight="520"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="CanResizeWithGrip"
    AllowsTransparency="False"
    ShowInTaskbar="True"
    UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- 8px outer radius, contents clipped to it — the Auto Filters / Legend Creation chrome. -->
    <Border x:Name="_outerBorder" BorderThickness="1" ClipToBounds="True"
            CornerRadius="{DynamicResource LemoineRadius_Window}">
        <Grid x:Name="_root">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="_toolbarRow" Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ── Toolbar: gear, title, document, then the three flow buttons and close.
                 There is NO footer bar; status lives in the floating chip below. -->
            <Border x:Name="_toolbarBorder" Grid.Row="0" ClipToBounds="True">
                <Grid x:Name="_toolbarGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="_gearText" VerticalAlignment="Center" />
                        <TextBlock x:Name="_titleText" VerticalAlignment="Center" />
                        <TextBlock x:Name="_docText" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="_toolbarActions" Grid.Column="2"
                                Orientation="Horizontal" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <!-- ── Content: 180 navigator | * canvas | 5 splitter | 300 properties.
                     The canvas column is the one that absorbs a splitter drag. -->
                <Grid x:Name="_contentGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="_navCol"    Width="180" />
                        <ColumnDefinition x:Name="_canvasCol" Width="*" MinWidth="360" />
                        <ColumnDefinition x:Name="_splitCol"  Width="5" />
                        <ColumnDefinition x:Name="_propsCol"  Width="300" MinWidth="260" />
                    </Grid.ColumnDefinitions>

                    <!-- ── Navigator: building selector | divider | list | docked footer.
                         Two levels deep only — levels with their areas, sheet sizes with
                         their groups. View definitions live in the properties pane. -->
                    <Border x:Name="_navBorder" Grid.Column="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ContentControl x:Name="_buildingSlot" Grid.Row="0" />
                            <Border x:Name="_navDivider" Grid.Row="1" Height="1" />

                            <ScrollViewer x:Name="_listScroll" Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="_listStack" />
                            </ScrollViewer>

                            <Border x:Name="_navFooterBorder" Grid.Row="3" BorderThickness="0,1,0,0">
                                <StackPanel x:Name="_navFooter" Orientation="Horizontal" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ── Canvas: 31px breadcrumb + Plan|Sheet toggle, then the drawing.
                         Overlays (legend, scale chips, empty state) sit in _planHost on
                         top of the canvas itself. -->
                    <Border x:Name="_canvasBorder" Grid.Column="1" BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="_crumbRow" Height="31" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border x:Name="_crumbBorder" Grid.Row="0" ClipToBounds="True"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="_crumbPanel" Grid.Column="0"
                                                Orientation="Horizontal" VerticalAlignment="Center" />
                                    <StackPanel x:Name="_crumbRight" Grid.Column="2"
                                                Orientation="Horizontal" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Grid x:Name="_planHost" Grid.Row="1" ClipToBounds="True" />
                        </Grid>
                    </Border>

                    <GridSplitter x:Name="_splitter" Grid.Column="2" Width="5"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="Transparent" Cursor="SizeWE"
                                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="False" />

                    <!-- ── Properties: header, cards, field grids. The bottom padding that
                         clears the floating chip is applied in code (ApplyFloatingInset). -->
                    <Border x:Name="_propsBorder" Grid.Column="3" BorderThickness="1,0,0,0">
                        <ScrollViewer x:Name="_propsScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="_detailStack" />
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Floating bottom-right status chip — replaces the old footer status text. -->
                <ContentControl x:Name="_floatingSlot"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Panel.ZIndex="50" Margin="0,0,16,16" />
            </Grid>
        </Grid>
    </Border>
</Window>
