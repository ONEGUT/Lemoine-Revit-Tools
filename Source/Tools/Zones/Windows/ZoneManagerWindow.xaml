<Window
    x:Class="LemoineTools.Tools.Zones.Windows.ZoneManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Lemoine Tools — Zone Manager"
    Width="1180" Height="700"
    MinWidth="900" MinHeight="520"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="CanResizeWithGrip"
    AllowsTransparency="False"
    ShowInTaskbar="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="_outerBorder" BorderThickness="1" ClipToBounds="True">
        <Grid x:Name="_root">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*"  />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <!-- Toolbar: title + document, close on the right -->
            <Border x:Name="_toolbarBorder" Grid.Row="0" ClipToBounds="True" BorderThickness="0,0,0,1">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="_titleText" VerticalAlignment="Center" />
                        <TextBlock x:Name="_docText" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="_toolbarActions" Grid.Column="2"
                                Orientation="Horizontal" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Content: rail | splitter | detail -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="_railCol" Width="300" MinWidth="220" MaxWidth="460" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="_railBorder" Grid.Column="0" BorderThickness="0,0,1,0">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBox x:Name="_searchBox" VerticalContentAlignment="Center" />
                            <TextBlock x:Name="_searchHint" Margin="9,0,0,0"
                                       VerticalAlignment="Center" FontStyle="Italic"
                                       IsHitTestVisible="False" />
                        </Grid>

                        <StackPanel x:Name="_tabStrip" Grid.Row="1"
                                    Orientation="Horizontal" Margin="0,10,0,8" />

                        <Border x:Name="_listBorder" Grid.Row="2" BorderThickness="1"
                                CornerRadius="{DynamicResource LemoineRadius_SM}">
                            <ScrollViewer x:Name="_listScroll"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,5">
                                <StackPanel x:Name="_listStack" />
                            </ScrollViewer>
                        </Border>

                        <StackPanel x:Name="_railActions" Grid.Row="3"
                                    Orientation="Horizontal" Margin="0,8,0,0" />
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="6"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              ShowsPreview="False" />

                <ScrollViewer x:Name="_detailScroll" Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="16,12">
                    <StackPanel x:Name="_detailStack" />
                </ScrollViewer>
            </Grid>

            <!-- Footer: status left, actions right -->
            <Border x:Name="_footerBorder" Grid.Row="2" ClipToBounds="True" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="_statusText" Grid.Column="0" VerticalAlignment="Center" />
                    <StackPanel x:Name="_footerActions" Grid.Column="2"
                                Orientation="Horizontal" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
