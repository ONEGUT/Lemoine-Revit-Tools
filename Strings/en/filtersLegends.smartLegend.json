// filtersLegends.smartLegend.json — Smart Legend tool (window UI + run log).
// Files: Source/Tools/FiltersLegends/SmartLegend/SmartLegendViewModel.cs (steps, pickers,
//        options), Source/Tools/FiltersLegends/SmartLegend/SmartLegendRunHandler.cs (scan,
//        legend build, placement), Source/Commands/FiltersLegends/SmartLegendCommand.cs.
// The tool reads the views on each selected sheet, finds every filter that actually colours
// something visible there, and builds one legend per sheet from the existing Auto Filters
// rules. It never creates a filter or a rule.
// Kept in code (not externalized): the imperial view-scale ladder (data mirroring Revit's own
// dropdown), the "solid"/"square" shape tokens persisted on LegendBlockConfig, and the
// default naming patterns "{SheetNumber} - LEGEND" / "LEGEND" (token strings resolved by
// TokenResolver, not prose).
{
  "title":      "Smart Legend",
  "runLabel":   "Build Legends →",
  // Noun for the run strip's primary count.
  "resultNoun": "legends",

  "steps": {
    "sheets":  "Sheets",
    "content": "Legend Content",
    "run":     "Review & Build"
  },

