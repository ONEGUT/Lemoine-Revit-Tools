    "noHeatmapFilters":  "No existing heatmap filters found.",
    "removingFilters":   "Removing {0} existing heatmap filter(s)…",
    "filterDeleteError": "Could not delete filter '{0}': {1}.",
    "tradeRegistered":   "Registered '{0}' trade with {1} rule(s).",
    "rulesUpdateFailed": "Filters applied, but could not update the rules list: {0}.",
    "linkNotByHost":     "Link \"{0}\" in view \"{1}\" is displayed \"{2}\", not \"By Host View\" — its ceilings will not be colored. Set it to \"By Host View\" in Visibility/Graphics to include them."
