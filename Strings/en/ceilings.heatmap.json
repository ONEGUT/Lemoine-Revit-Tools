    "tagLinkedFailed":   "Could not place tag on linked ceiling {0}: {1}.", // {0}=id {1}=error
    "tagsPlacedReplaced":"Tags placed: {0} ({1} existing removed and replaced, {2} net new).",
    "tagsPlacedNone":    "Tags placed: {0} (none previously existed).",
    "resourceMissing":   "Embedded resource '{0}' not found in assembly. Verify the .rfa is marked as EmbeddedResource in the .csproj.",
