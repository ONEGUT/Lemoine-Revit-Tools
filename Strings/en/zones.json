    "viewDef": {
      "section": "View",
      "name": "Name",
      "kind": "View type",
      "familyType": "View family type",
      "template": "View template",
      "scaleMode": "Scale",
      "scale": "Fixed scale",
      "viewRange": "View range",
      "namePattern": "View name",
      "duplicateMode": "Second sheet size",
      "top": "Top",
