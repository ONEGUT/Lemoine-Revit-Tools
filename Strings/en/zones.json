      "extentsValue": "{0}' × {1}'",
      "extentsUnresolved": "not resolved yet",
      // {0} = scope box name
      "boxMissing": "Scope box '{0}' is not in this document. The area is kept, but its extents cannot be refreshed until it is re-pointed.",
