{
  // Project Zones — the per-project library of buildings, levels, areas, view
  // view definitions, sheet sets and exact sheet placements.
  //
  // JSONC: // comments are stripped before parsing. Keys are dot-flattened, so
  // "picker.summary" here is AppStrings.T("zones.picker.summary").
  "picker": {
    // ZonePicker — the reusable Building/Level/Area tree control.
    "searchHint": "Search zones…",
    "clear": "Clear",
    "clearAll": "Clear all",
    "selectAll": "Select all",
    // {0} = selected cell count, {1} = total cells listed
    "summary": "{0} of {1} selected",
    // {0} = number of matching cells
    "matchCount": "{0} matches",
    // Shown when the library has no buildings/levels/areas at all.
    "emptyLibrary": "No zones defined yet. Open the Zone Manager to create them.",
    // {0} = the search query
    "noMatches": "Nothing matches “{0}”.",
    // Levels and areas not assigned to any building.
    "unassigned": "Unassigned",
    // A cell whose extents have never been resolved cannot be placed.
    "noExtents": "no extents"
  },

