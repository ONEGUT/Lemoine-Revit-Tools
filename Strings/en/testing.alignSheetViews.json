// testing.alignSheetViews.json — Align Sheet Views tool + run-handler (Log) lines.
// Command: AlignSheetViewsCommand. NOTE: log-level tone tokens ("warn"/"fail"/"pass") and the
// "—" placeholder glyph stay in code. The run log carries no "info" tone at all: it is one
// roll-up line per target sheet plus everything that actually went wrong, so every line here
// is one the user is meant to read.
{
  "title": "Align Sheet Views",
  "runLabel": "Align Views →",
  "steps": {
    "S1": "Source Sheets", "S2": "Target Sheets", "S3": "Options", "S4": "Review & Run"
  },
  "labels": {
    "secReference": "REFERENCE SHEETS",
    "noSheets": "No sheets were found in this project.",
    "pickerSource": "Source reference sheets",
    "secTargets": "SHEETS TO ALIGN",
    "pickerTarget": "Target sheets to align",
    // Shown instead of the picker when every sheet in the project is already a reference sheet.
    "noTargetsLeft": "Every sheet in this project is selected as a reference sheet, so there is nothing left to align. Go back and untick the sheets you want to move.",
    "secOverlap": "FALLBACK MATCH — MINIMUM OVERLAP (%)",
    "secInherit": "INHERIT FROM SOURCE VIEW",
    "optScopeBox": "Scope box assignment",
    "optGrids": "Grid extents, heads and elbows",
    "optCropVis": "Crop region visibility",
    "optCropSize": "Crop size + annotation crop",
    // Replaces optCropSize while "Scope box assignment" is ticked: the scope box governs the
    // crop rectangle, so there is no separate crop-size decision left to make.
    "impliedCropSize": "Crop size inherited from the scope box"
  },
  "review": {
    "itemSource": "Reference Sheets", "itemTargets": "Target Sheets", "itemOverlap": "Fallback Overlap",
    "itemInherit": "Inherit",
    "none": "— (none selected)",
    "sheetCount": "{0} sheet(s)",
    "overlapValue": "{0}% minimum (scope box matched first)",
    // View titles are always aligned, so the clause is part of the sentence rather than a fragment.
    "warning": "Target viewports and their view titles{0} will be modified on every selected sheet.",
    "warnInherit": " (plus inherited {0})"
  },
  "inherit": {
    "nothing": "Nothing",
    "scopeBox": "scope box",
    "gridExtents": "grid extents, heads and elbows",
    "cropVisibility": "crop visibility",
    "cropSize": "crop size"
  },
  "summaries": {
    "s1Single": "1 selected",
    "s3Overlap": "overlap {0}%",
    "s3Inherit": "  |  inherit",
    "S4": "Ready to run"
  },
  "log": {
    "noDoc":              "No active project — open a document and try again.",
    "noSourceSheets":     "No valid source sheets — open a document and pick at least one reference sheet.",
    "sourceNoViews":      "Source '{0}' has no placeable views with a crop box — ignored as a reference.",
    "noSourcesWithViews": "None of the selected source sheets carry placeable views — nothing to align to.",
    "noTargets":          "No valid target sheets (a sheet listed as both source and target is treated as a source).",
    "issuesRecorded":     "{0} non-fatal issue(s) recorded — see diagnostics log.",
    "done":               "Done — {0} aligned, {1} error(s), {2} skipped across {3} target sheet(s).",
    "fatalError":         "Align Sheet Views error: {0}",
    "stoppedByUser":      "Stopped by user — {0} of {1} target sheet(s) processed; work so far preserved.",
    "noPlaceableViews":   "[{0}] No placeable views found — cannot align this sheet.",
    "noCounterpart":      "[{0}] No counterpart views found on any of the {1} source sheet(s) — left unchanged.",
    "missing":            "[{0}] MISSING counterpart for source view '{1}'.",
    "ambiguous":          "[{0}] AMBIGUOUS — source view '{1}' overlaps both '{2}' and '{3}'. Left unchanged.",
    "extra":              "[{0}] EXTRA view '{1}' has no source counterpart — left unchanged.",
    "scaleDiffers":       "[{0}] '{1}' scale 1:{2} differs from source 1:{3} — only the anchor point will register.",
    "orientationDiffers": "[{0}] '{1}' orientation differs from source — field overlay not guaranteed.",
    "rotated":            "[{0}] '{1}' viewport is rotated ({2}) — overlay aligns the anchor only.",
    // The condensed run log: one line per target sheet, standing in for the routine detail.
    "sheetOk":            "[{0}] {1} matching view(s) found and aligned.",
    "sheetWithIssues":    "[{0}] {1} matching view(s) aligned — {2} issue(s) reported above.",
    // Used instead of the two above when more than one reference sheet was selected, so a target
    // aligned to the wrong reference is visible without adding a second line per sheet.
    "sheetOkRef":         "[{0}] {1} matching view(s) found and aligned to reference '{2}'.",
    "sheetWithIssuesRef": "[{0}] {1} matching view(s) aligned to reference '{3}' — {2} issue(s) reported above.",
    "failedMove":         "[{0}] Failed to move '{1}' — see diagnostics log.",
    "couldNotAssignScope":"[{0}] Could not assign scope box to '{1}'.",
    "couldNotMatchCropSize":"[{0}] Could not match crop size for '{1}'.",
    "couldNotMatchAnnoCrop":"[{0}] Could not match annotation crop for '{1}' (this view type may not support one).",
    "couldNotMatchCropVis":"[{0}] Could not match crop visibility for '{1}'.",
    "noGrids":            "[{0}] '{1}' has no grids — nothing for grid inheritance to copy.",
    // Changed vs already-matching are split deliberately: a single "N trimmed" that counted
    // no-op writes is exactly what made a broken run look like a successful one. Only the zero
    // case prints — a pass that did the work does not need narrating.
    "gridsResult":        "[{0}] Grids on '{1}': {2} updated, {3} already matching.",
    "gridElbowStuck":     "[{0}] '{1}' grid '{2}': has a head elbow the source does not, and Revit would not clear it — left in place.",
    "gridElbowRejected":  "[{0}] '{1}' grid '{2}': Revit rejected the source head elbow — the leader was created but not repositioned.",
    // One line per remaining cause, so a zero result always names its reason. A bare
    // "N skipped" cannot be acted on — it was hiding grids whose source view had no
    // 2D extents at all, reported as if they were invisible or non-collinear.
    "gridsBlocked":       "[{0}] Grids on '{1}': {2} blocked by a setting this tool will not change — see the lines above.",
    "gridsNotShowable":   "[{0}] Grids on '{1}': Revit will not display {2} in this view — skipped (its settings already match the source view).",
    "gridsNoSourceCurve": "[{0}] Grids on '{1}': {2} claim view-specific extents but returned no curve — not trimmed.",
    "gridsRejected":      "[{0}] Grids on '{1}': {2} were rejected by Revit when writing the curve — extent mode restored, see diagnostics log.",
    "gridsErrored":       "[{0}] Grids on '{1}': {2} failed with an error — see diagnostics log.",
    "gridsMultiSegment":  "[{0}] Grids on '{1}': {2} are multi-segment — only the first segment's extents were copied.",
    "gridsUnbound":       "[{0}] Grids on '{1}': {2} returned an unbound (infinite) line — Revit cannot use one as an extent, not trimmed.",
    "gridsTargetOnly":    "[{0}] Grids on '{1}': {2} appear in the target view but not the source — left unchanged.",
    "gridsRestoreFailed": "[{0}] '{1}' grid '{2}': write failed AND its extent mode could not be restored — that end is now 2D with no curve set.",
    "couldNotTrimGrids":  "[{0}] Could not trim grids for '{1}'.",
    // Revit has many ways to hide a grid; the cause is named so "not trimmed" can be acted on.
    // Only a cause that DIFFERS from the source view is ever named — one present on both views
    // cannot explain why the grid shows in one and not the other.
    "gridCauseFilter":    "view filter '{0}' hides it (left unchanged — it governs other categories too)",
    "gridCauseTemplate":  "a visibility write was rejected — view template '{0}' most likely controls it; see diagnostics log for the exact error",
    "gridBlocked":        "[{0}] '{1}' grid '{2}': {3}. Trim attempted anyway.",
    "couldNotMatchTitleLine":"[{0}] Could not match title line length for '{1}'.",
    "couldNotAlignTitle": "[{0}] Could not align title for '{1}'.",
    "viewTitlesSome":     "View titles: {0} aligned, {1} could not be adjusted.",
    // Placement is PREDICTED from the source view and this run's own writes rather than read back
    // after a regenerate. SetBoxCenter is absolute, so a prediction that missed is corrected
    // exactly — never nudged — once the run regenerates and the real crop can be measured.
    "placementCorrected": "[{0}] '{1}' crop differed from the predicted geometry — viewport re-placed ({2}' correction).",
    "couldNotVerifyPlacement": "[{0}] Could not verify the final placement of '{1}' — see diagnostics log.",
    "couldNotReadAnnoCrop": "[warn] Could not read the annotation crop on view '{0}' — it is treated as having none, so this view may not register exactly.",
    "annoScaleDiffers":   "[{0}] '{1}' scale differs from its source — annotation-crop margins are copied in model feet, so the printed margin will differ."
  }
}
