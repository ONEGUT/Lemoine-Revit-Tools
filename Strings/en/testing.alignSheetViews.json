// testing.alignSheetViews.json — Align Sheet Views tool + run-handler (Log) lines.
// Command: AlignSheetViewsCommand. NOTE: log-level tone tokens ("info"/"warn"/"fail"/"pass")
// and the "—" placeholder glyph stay in code. Some run lines are composed from a base
// template plus a trailing fragment (grids/titles/would-align) — both parts live here.
{
  "title": "Align Sheet Views",
  "runLabel": "Align Views →",
  "steps": {
    "S1": "Source Sheets", "S2": "Target Sheets", "S3": "Options", "S4": "Review & Run"
  },
  "labels": {
    "secReference": "REFERENCE SHEETS",
    "noteReference": "Their viewport positions are the ground truth. These sheets are never moved. Each target sheet is aligned to whichever reference sheet matches it best.",
    "noSheets": "No sheets were found in this project.",
    "pickerSource": "Source reference sheets",
    "secTargets": "SHEETS TO ALIGN",
    "noteTargets": "Each target sheet's views are moved to overlay their counterparts on the best-matching reference sheet. Any reference sheet ticked here is ignored.",
    "pickerTarget": "Target sheets to align",
    "secOverlap": "FALLBACK MATCH — MINIMUM OVERLAP (%)",
    "noteOverlap": "Views are matched by shared scope box first (exact). This overlap threshold is the fallback for views with no scope box: how much of a target view's drawn area must overlap a source view to be treated as counterparts. Lower it if counterparts are cropped to different sizes; raise it if unrelated views match.",
    "optAlignTitles": "Also align view titles (location + line length)",
    "noteAlignTitles": "After the viewports are aligned, each view title is moved to overlay its source title and its title line length is matched. Done last, since moving a viewport moves its title.",
    "secInherit": "INHERIT FROM SOURCE VIEW",
    "optScopeBox": "Scope box assignment",
    "noteScopeBox": "Assign the source view's scope box to each matched target view. Applied FIRST — before alignment — because a scope box rewrites the crop the alignment reads.",
    "optGrids": "Grid 2D extents (trim gridlines to match)",
    "noteGrids": "Trim each target grid's per-view (2D) extents so its gridlines start and stop exactly where they do in the source view.",
    "optCropVis": "Crop region visibility",
    "noteCropVis": "Match whether the crop-region boundary is shown or hidden, to the source view.",
    "optCropSize": "Crop size + annotation crop",
    "noteCropSize": "Match the target's crop size and annotation-crop margins to the source. For views that also inherit a scope box, the scope box governs the crop, so only annotation-crop margins are applied.",
    "secMode": "MODE",
    "optPreview": "Preview only — report matches and errors without moving any viewport",
    "notePreview": "Run this first to confirm every target sheet has a clean set of counterparts before committing any moves."
  },
  "review": {
    "itemSource": "Reference Sheets", "itemTargets": "Target Sheets", "itemOverlap": "Fallback Overlap",
    "itemTitles": "View Titles", "itemInherit": "Inherit", "itemMode": "Mode",
    "none": "— (none selected)",
    "sheetCount": "{0} sheet(s)",
    "overlapValue": "{0}% minimum (scope box matched first)",
    "titlesAligned": "Aligned (location + line length)",
    "titlesUnchanged": "Left unchanged",
    "modePreview": "Preview only (no moves)",
    "modeAlign": "Align viewports",
    "note": "Each target sheet is aligned to the reference sheet it matches best. Views are paired by shared scope box first, crop-region overlap otherwise, then the target viewport is moved so the two register. Missing or ambiguous counterparts are reported, never moved.",
    "warning": "Target viewports{0}{1} will be modified on every selected sheet.",
    "warnTitles": " and their view titles",
    "warnInherit": " (plus inherited {0})"
  },
  "inherit": {
    "nothing": "Nothing",
    "scopeBox": "scope box",
    "gridExtents": "grid extents",
    "cropVisibility": "crop visibility",
    "cropSize": "crop size"
  },
  "summaries": {
    "s1Single": "1 selected",
    "s3Overlap": "overlap {0}%",
    "s3Titles": "  |  titles",
    "s3Inherit": "  |  inherit",
    "s3Preview": "  |  preview",
    "S4": "Ready to run"
  },
  "log": {
    "noDoc":              "No active project — open a document and try again.",
    "noSourceSheets":     "No valid source sheets — open a document and pick at least one reference sheet.",
    "sourceNoViews":      "Source '{0}' has no placeable views with a crop box — ignored as a reference.",
    "sourceRefViews":     "Source '{0}': {1} reference view(s).",
    "noSourcesWithViews": "None of the selected source sheets carry placeable views — nothing to align to.",
    "noTargets":          "No valid target sheets (a sheet listed as both source and target is treated as a source).",
    "previewOnly":        "Preview only — reporting matches; no viewports will be moved.",
    "issuesRecorded":     "{0} non-fatal issue(s) recorded — see diagnostics log.",
    "done":               "Done — {0} aligned, {1} error(s), {2} skipped across {3} target sheet(s).",
    "fatalError":         "Align Sheet Views error: {0}",
    "stoppedByUser":      "Stopped by user — {0} of {1} target sheet(s) processed; work so far preserved.",
    "noPlaceableViews":   "[{0}] No placeable views found — cannot align this sheet.",
    "noCounterpart":      "[{0}] No counterpart views found on any of the {1} source sheet(s) — left unchanged.",
    "bestReference":      "[{0}] Best reference: '{1}' — {2} of {3} view(s) matched.",
    "otherCandidates":    "[{0}] Other candidates: {1}.",
    "candidateItem":      "'{0}' ({1})",
    "missing":            "[{0}] MISSING counterpart for source view '{1}'.",
    "ambiguous":          "[{0}] AMBIGUOUS — source view '{1}' overlaps both '{2}' and '{3}'. Left unchanged.",
    "extra":              "[{0}] EXTRA view '{1}' has no source counterpart — left unchanged.",
    "scaleDiffers":       "[{0}] '{1}' scale 1:{2} differs from source 1:{3} — only the anchor point will register.",
    "orientationDiffers": "[{0}] '{1}' orientation differs from source — field overlay not guaranteed.",
    "rotated":            "[{0}] '{1}' viewport is rotated ({2}) — overlay aligns the anchor only.",
    "wouldAlign":         "[{0}] Would align '{1}' → source '{2}'{3}",
    "wouldAlignTitle":    " (and its view title).",
    "wouldAlignEnd":      ".",
    "scopeBoxApplied":    "[{0}] {1} scope box assignment(s) applied.",
    "aligned":            "[{0}] Aligned '{1}' → source '{2}'.",
    "failedMove":         "[{0}] Failed to move '{1}' — see diagnostics log.",
    "couldNotAssignScope":"[{0}] Could not assign scope box to '{1}'.",
    "cropScopeGoverned":  "[{0}] '{1}' crop is scope-box governed — crop-size inheritance skipped (annotation crop still applied).",
    "couldNotMatchCropSize":"[{0}] Could not match crop size for '{1}'.",
    "couldNotMatchAnnoCrop":"[{0}] Could not match annotation crop for '{1}' (this view type may not support one).",
    "couldNotMatchCropVis":"[{0}] Could not match crop visibility for '{1}'.",
    "noGrids":            "[{0}] '{1}' has no grids to trim.",
    // Changed vs already-matching are split deliberately: a single "N trimmed" that counted
    // no-op writes is exactly what made a broken run look like a successful one.
    "gridsResult":        "[{0}] Grids on '{1}': {2} updated, {3} already matching.",
    "gridsWouldResult":   "[{0}] Grids on '{1}': {2} would be updated, {3} already matching.",
    "gridWouldMove":      "[{0}] '{1}' grid '{2}': ends would move {3}' / {4}'.",
    // Heads/tails are a separate property from the extents — matching ends still show no head
    // if the source has its bubble on and the target does not.
    "gridsBubbles":       "[{0}] Grids on '{1}': {2} head/tail bubbles matched to the source.",
    "gridsWouldBubbles":  "[{0}] Grids on '{1}': {2} head/tail bubbles would be matched to the source.",
    // One line per remaining cause, so a zero result always names its reason. A bare
    // "N skipped" cannot be acted on — it was hiding grids whose source view had no
    // 2D extents at all, reported as if they were invisible or non-collinear.
    "gridsModelSource":   "[{0}] Grids on '{1}': {2} use model (3D) extents in the source view — target ends reset to model to match.",
    "gridsNotVisible":    "[{0}] Grids on '{1}': {2} cannot be shown in this view — not trimmed.",
    "gridsNoSourceCurve": "[{0}] Grids on '{1}': {2} claim view-specific extents but returned no curve — not trimmed.",
    "gridsRejected":      "[{0}] Grids on '{1}': {2} were rejected by Revit when writing the curve — extent mode restored, see diagnostics log.",
    "gridsErrored":       "[{0}] Grids on '{1}': {2} failed with an error — see diagnostics log.",
    "gridsMultiSegment":  "[{0}] Grids on '{1}': {2} are multi-segment — only the first segment's extents were copied.",
    "gridsTargetOnly":    "[{0}] Grids on '{1}': {2} appear in the target view but not the source — left unchanged.",
    "gridsRestoreFailed": "[{0}] '{1}' grid '{2}': write failed AND its extent mode could not be restored — that end is now 2D with no curve set.",
    "couldNotTrimGrids":  "[{0}] Could not trim grids for '{1}'.",
    "couldNotMatchTitleLine":"[{0}] Could not match title line length for '{1}'.",
    "couldNotAlignTitle": "[{0}] Could not align title for '{1}'.",
    "viewTitlesOk":       "View titles: {0} aligned.",
    "viewTitlesSome":     "View titles: {0} aligned, {1} could not be adjusted.",
    "noteNoCrop":         "[note] View '{0}' has no active crop — region matched from its default crop box.",
    "couldNotReadAnnoCrop": "[warn] Could not read the annotation crop on view '{0}' — it is treated as having none, so this view may not register exactly.",
    "annoScaleDiffers":   "[{0}] '{1}' scale differs from its source — annotation-crop margins are copied in model feet, so the printed margin will differ.",

    // Preview-only diagnostics. Emitted per matched pair when \"Preview only\" is ticked.
    // Their purpose is to settle, on a real plot, whether a viewport's on-sheet footprint
    // includes the annotation crop (the assumption the alignment maths rests on) and to name
    // which views the old and new formulas place differently.
    "diagHeader":         "[diag] [{0}] '{1}' → source '{2}'",
    "diagScale":          "[diag]   scale src 1:{0} / tgt 1:{1}   rotation {2}   basisX dot {3}  basisY dot {4}",
    "diagCrop":           "[diag]   model crop (ft)              src {0} x {1} / tgt {2} x {3}",
    "diagAnno":           "[diag]   annotation crop active       src {0} / tgt {1}",
    "diagAnnoOff":        "[diag]   anno offsets (ft) src L{0} R{1} B{2} T{3}  |  tgt L{4} R{5} B{6} T{7}",
    "diagOutline":        "[diag]   ACTUAL box outline (sheet ft) src {0} x {1} / tgt {2} x {3}",
    "diagPredNoAnno":     "[diag]   predicted WITHOUT anno crop   src {0} x {1} / tgt {2} x {3}",
    "diagPredAnno":       "[diag]   predicted WITH anno crop      src {0} x {1} / tgt {2} x {3}",
    "diagVerdict":        "[diag]   → viewport footprint includes the annotation crop: {0}",
    "diagVerdictYes":     "YES — the alignment fix's assumption holds.",
    "diagVerdictNo":      "NO — the alignment fix's assumption does NOT hold here; report this line.",
    "diagCentres":        "[diag]   box centre (current)          src {0} / tgt {1}",
    "diagNewCentre":      "[diag]   target box centre — old formula {0} → new formula {1}   delta {2} ft",
    "diagRotCandidates":  "[diag]   ROTATED viewport — candidate A (x,y)→(y,-x) gives {0}; candidate B (x,y)→(-y,x) gives {1}. Confirm which is right on the plot.",
    "diagFailed":         "[diag] [{0}] Could not produce diagnostics for '{1}'.",
    "diagMissingHdr":     "[diag] [{0}] No counterpart for source view '{1}' — candidates considered:",
    "diagMissingCand":    "[diag]   '{0}' in-plane overlap {1}% (threshold {2}%), depth ranges {3}",
    "diagNoCands":        "[diag]   (no candidate of the same view type and orientation on this sheet)",
    "diagDepthOk":        "overlap",
    "diagDepthNo":        "DO NOT overlap — candidate vetoed on depth"
  }
}
