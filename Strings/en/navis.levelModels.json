    "explain":    "Levels are read from one model\u2019s own tree structure. Pick the model that carries the full level breakdown, usually the architectural file.",
    "noGridsFallback": "This federation has no grid systems, so levels are being read from a model\u2019s tree instead \u2014 a much weaker source. Loading a model that carries Revit levels will give a better list.",
    "confirm":    "Read levels \u2192",
    "pendingRead":"{0} has not been read yet \u2014 confirm this step to read its levels.",
    "done":       "Found {0} level(s) in {1}. {2} of {3} models matched by name.",
    "doneGrids":  "Found {0} level(s) in grid system {1}. {2} of {3} models matched by name.",
    "noGridLevels":  "Grid system {0} reports no levels. Systems in this document: {1}. Pick another, or add levels by hand on the next step.",
