    "failed":     "Scan failed: {0}",
    "noDocument": "No model open. Open your federated NWF/NWD and reopen this tool.",
    "noModels":   "This document has no appended models, so there is nothing to scan.",
    "noLevels":   "{0} has no level groups \u2014 add levels by hand on the next step, or pick a different model.",
    // {1} is the tree, depth by depth, from DescribeTree, so a no-levels result shows what the
    // model DOES hold instead of dead-ending. A Revit NWC only carries level groups when it was
    // exported from Revit with Divide File into Levels turned on.
    "noLevelsButChildren": "No layer of {0}\u2019s tree reads as levels. What it holds: {1}. That usually means the NWC was not exported from Revit with \u201cDivide File into Levels\u201d on \u2014 pick a different model, add levels by hand on the next step, or re-export it.",
    "readFrom":   "Read from {0}.",
    // Assignment outcome, appended to "done". A federation split by DISCIPLINE (Arch / Struct /
    // Mech) names no level in any file name, so allToAll is the normal path there, not an edge case.
    "allToAll":   "No model file name named a level, so every model went into \u201con every level\u201d for the elevation bands to crop \u2014 change any of it on the next step.",
    "noneMatched": "No model file name named a level and no level has an elevation band, so nothing was auto-assigned \u2014 assign models on the next step.",
    "andMore":    " (+{0} more)",
    "emptyTree":  "nothing below its root",
    // Shown when the federation has never been saved: the store is keyed by file path, so there
