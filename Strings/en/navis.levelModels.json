// navis.levelModels.json — Level Models (Navisworks add-in): export one NWD per
// level holding only the models assigned to that level.
// Files: LemoineNavisworks/Source/LevelModels/LevelModelsViewModel.cs, NavisLevelModels.cs.
// Keys are addressed as "navis.levelModels.<section>.<key>".
//
// NOTE — deliberately left in code (not externalized):
//  - Filename pattern tokens "{level}" / "{model}" are logic tokens fed to string.Replace.
//  - Caret/check glyphs (▶ ▼ ✓) and char.ConvertFromUtf32(0xE74D) per CLAUDE.md convention.
//  - DiagnosticsLog.* context strings are developer diagnostics, out of scope.
{
  "title":    "Level Models",
  "runLabel": "Export Level NWDs →",

