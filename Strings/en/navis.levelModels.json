    "notPersisted": "This federation has not been saved to a file yet, so this setup cannot be remembered \u2014 save the NWF/NWD first.",
    "restored":   "Restored your saved setup \u2014 {0} level(s).",
    "restoredDropped": "Restored your saved setup \u2014 {0} level(s); {1} assignment(s) dropped for models no longer in this federation."
